# Server Configuration
PORT=10000
NODE_ENV=development

# Supabase Configuration (NEVER commit these values)
SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Secrets (Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
COOKIE_SECRET=generate_a_random_64_character_hex_string_here
CSRF_SECRET=generate_another_random_64_character_hex_string_here

# Session Configuration
SESSION_DURATION_MS=86400000        # 24 hours
INACTIVITY_TIMEOUT_MS=1800000       # 30 minutes
REFRESH_TOKEN_EXPIRY_MS=1209600000  # 14 days

# Security
COOKIE_DOMAIN=                      # Optional, leave empty for same-origin
CLIENT_URL=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000         # 15 minutes
RATE_LIMIT_MAX_LOGIN=5              # Max login attempts per window
RATE_LIMIT_MAX_REGISTER=3           # Max register attempts per hour
RATE_LIMIT_MAX_REFRESH=10           # Max refresh attempts per minute

# Device Fingerprint
FINGERPRINT_TOLERANCE=80            # Percentage match required (0-100)

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=Samara Repository <your-email@gmail.com>
OTP_EXPIRY_MINUTES=10

# Monitoring (Optional)
SENTRY_DSN=
DATADOG_API_KEY=
